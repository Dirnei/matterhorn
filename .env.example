# Copy this to .env (gitignored) and adjust. docker compose reads .env automatically,
# so `docker compose up --build` picks up whichever controller you select here.

# --- Real controller: point at matterjs-server (e.g. on the Pi) ---
CONTROLLER_KIND=matterjs-server
CONTROLLER_WS_URL=ws://192.168.0.118:5580/ws
DEV_SEED=false

# --- Fake controller: in-memory demo devices, no hardware (quick switch) ---
# CONTROLLER_KIND=fake
# DEV_SEED=true
